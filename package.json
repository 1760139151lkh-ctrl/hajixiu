{
  "name": "likeness",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Likeness — a personal image studio you talk to. Rooms, weather, and pictures made by conversation.",
  "scripts": {
    "build": "node tools/build.mjs",
    "serve": "node tools/serve.mjs",
    "sitters": "node tools/sitters.mjs",
    "tour": "node tools/tour.mjs",
    "check": "tsc -p web/jsconfig.json",
    "test": "playwright test",
    "accept": "LIKENESS_ACCEPT=1 playwright test --project=accept --project=accept-iphone",
    "build:wechat": "webpack --config tools/wechat/webpack.cjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "css-loader": "7.1.5",
    "esbuild": "0.28.2",
    "mini-css-extract-plugin": "2.10.2",
    "miniprogram-element": "2.2.23",
    "miniprogram-render": "2.2.29",
    "mp-webpack-plugin": "1.6.6",
    "postcss": "8.5.33",
    "postcss-selector-parser": "7.2.1",
    "typescript": "^7.0.2",
    "webpack": "5.113.0",
    "webpack-cli": "7.3.1"
  }
}
